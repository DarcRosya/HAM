{
  "name": "ham-root",
  "private": true,
  "scripts": {
    "db": "docker compose up -d",
    "db:down": "docker compose down",
    "server": "npm --prefix server run dev",
    "client": "npx serve ./client -p 5173",
    "dev": "concurrently -k -n db,server,client -c \"blue,green,magenta\" \"npm run db\" \"npm run server\" \"npm run client\"",
    "format": "prettier --write \"**/*.{js,css,html,json}\"",
    "setup": "npm install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.3.3"
  }
}
