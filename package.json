{
  "name": "ham",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:full": "npm run db && npm run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "db": "docker compose up -d --build",
    "db:down": "docker compose down",
    "format": "prettier --write \"**/*.{js,jsx,css,md,json,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
